@model AgriStreamIoT.Models.AppUser

@{
    ViewData["Title"] = "Delete User";
}

<h1>Delete User</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this AgriStream user account?
</div>

<div>
    <h4>User Account Details</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            Username
        </dt>
        <dd class="col-sm-9">
            @Model.Username
        </dd>

        <dt class="col-sm-3">
            Role
        </dt>
        <dd class="col-sm-9">
            @Model.Role
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <button type="submit"
                class="btn btn-danger">
            Delete User
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>