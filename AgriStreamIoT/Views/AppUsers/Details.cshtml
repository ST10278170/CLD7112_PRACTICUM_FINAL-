@model AgriStreamIoT.Models.AppUser

@{
    ViewData["Title"] = "User Details";
}

<h1>User Details</h1>

<div>
    <h4>AgriStream User Account</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            Username
        </dt>
        <dd class="col-sm-9">
            @Model.Username
        </dd>

        <dt class="col-sm-3">
            Role
        </dt>
        <dd class="col-sm-9">
            @Model.Role
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Edit User
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Users
    </a>
</div>