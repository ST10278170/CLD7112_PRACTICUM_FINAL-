@model IEnumerable<AgriStreamIoT.Models.Device>

@{
    ViewData["Title"] = "Device Registry";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>IoT Device Registry</h1>
        <p class="text-muted">
            Monitor and manage registered AgriStream field devices.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Register New Device
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No IoT devices have been registered yet.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-bordered align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Device Name</th>
                    <th>Device Type</th>
                    <th>Field Location</th>
                    <th>Status</th>
                    <th>Last Updated</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.DeviceName
                        </td>

                        <td>
                            @item.DeviceType
                        </td>

                        <td>
                            @item.FieldLocation
                        </td>

                        <td>
                            @if (item.OperationalStatus == "Online")
                            {
                                <span class="badge bg-success">
                                    Online
                                </span>
                            }
                            else if (item.OperationalStatus == "Irrigating")
                            {
                                <span class="badge bg-primary">
                                    Irrigating
                                </span>
                            }
                            else if (item.OperationalStatus == "Maintenance")
                            {
                                <span class="badge bg-warning text-dark">
                                    Maintenance
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Offline
                                </span>
                            }
                        </td>

                        <td>
                            @item.LastUpdated.ToString("yyyy-MM-dd HH:mm:ss")
                        </td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}